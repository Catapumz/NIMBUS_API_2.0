    }
  },
  "host": "35.180.113.93:3000",
  "basePath": "/",
  "tags": [
    {
      "name": "NIMBUS WALLS",
      "description": "API para comunicar la app y la base de datos en la nube"
    }
  ],
  "schemes": ["http"],
  "consumes": ["application/json"],
  "produces": ["application/json"],
  "paths": {
    "/subir_foto": {
      "post": {
        "tags": ["Fotos"],
        "summary": "Subir una imagen y guardarla en el servidor",
        "consumes": ["multipart/form-data"],
        "parameters": [
          {
            "name": "quepared",
            "in": "formData",
            "required": true,
            "type": "string"
          },
          {
            "name": "nombre_guardado",
            "in": "formData",
            "required": true,
            "type": "string"
          },
          {
            "name": "foto",
            "in": "formData",
            "required": true,
            "type": "file"
          }
        ],
        "responses": {
          "200": {
            "description": "Foto subida correctamente",
            "schema": {
              "$ref": "#/definitions/Foto"
            }
          }
        }
      }
    },

    "/listar_fotos/{quepared}": {
      "get": {
        "tags": ["Fotos"],
        "summary": "Listar fotos por pared",
        "parameters": [
          {
            "name": "quepared",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "Listado de fotos",
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/Foto"
              }
            }
          }
        }
      }
    },

    "/eliminar_foto/{id}": {
      "delete": {
        "tags": ["Fotos"],
        "summary": "Eliminar una foto",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "Foto eliminada"
          }
        }
      }
    },

    "/nuevo_layout": {
      "post": {
        "tags": ["Layouts"],
        "summary": "Crear un nuevo layout",
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/Layout"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Layout creado"
          }
        }
      }
    },

    "/listar_layouts/{quepared}": {
      "get": {
        "tags": ["Layouts"],
        "summary": "Listar layouts por pared",
        "parameters": [
          {
            "name": "quepared",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "Listado de layouts",
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/Layout"
              }
            }
          }
        }
      }
    },

    "/editar_layout/{id}": {
      "put": {
        "tags": ["Layouts"],
        "summary": "Editar un layout",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "in": "body",
            "name": "body",
            "schema": {
              "$ref": "#/definitions/Layout"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Layout actualizado"
          }
        }
      }
    },

    "/eliminar_layout/{id}": {
      "delete": {
        "tags": ["Layouts"],
        "summary": "Eliminar un layout",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "Layout eliminado"
          }
        }
      }
    },

    "/listar?quepared=25&dificultad=verde&isbloque=Travesía": {
      "get": {
        "summary": "Ejemplo de solicitud GET con parámetros en el cuerpo",
        "consumes": ["multipart/form-data"],

        "responses": {
          "200": {
            "description": "Success",
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/Listado itinerarios"
              }
            },
            "examples": {
              "application/json": [
                {
                  "name": "Mi via",
                  "autor": "Juanito",
                  "dificultad": 7,
                  "comentario": "Una via guapisima",
                  "presas": ["A", "B", "C"],
                  "quepared": 15,
                  "isbloque": "bloque"
                }
              ]
            }
          }
        }
      }
    },
    "/guardar": {
      "post": {
        "summary": "Ejemplo de solicitud POST con parámetros en el cuerpo",
        "consumes": ["multipart/form-data"],
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "description": "Parámetros de body para guardar un nuevo itinerario, son todos requeridos.",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "autor": {
                  "type": "string"
                },
                "dificultad": {
                  "type": "integer"
                },
                "comentario": {
                  "type": "string"
                },
                "presas": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "quepared": {
                  "type": "integer",
                  "enum": [15, 25]
                },
                "isbloque": {
                  "type": "string",
                  "enum": ["bloque", "travesia"]
                }
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "schema": {
              "type": "object",
              "items": {
                "$ref": "#/definitions/Via"
              }
            },
            "examples": {
              "application/json": {
                "itinerario": {
                  "name": "Mi via",
                  "autor": "Juanito",
                  "dificultad": 7,
                  "comentario": "Una via guapisima",
                  "presas": ["A", "B", "C"],
                  "quepared": 15,
                  "isbloque": "bloque"
                },
                "Mensaje": "itinerario creado con éxito"
              }
            }
          }
        }
      }
    },
    "/editar/id": {
      "put": {
        "summary": "Ejemplo de solicitud PUT con parámetros en el cuerpo",
        "consumes": ["multipart/form-data"],
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "description": "El id del itinerario a modificar se pasa por url, por ejemplo, si el id es 5783 la petición sería /editar/5783. En el body van los elements a modificar unicamente, aunque en el ejemplo estén todos.",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "autor": {
                  "type": "string"
                },
                "dificultad": {
                  "type": "integer"
                },
                "comentario": {
                  "type": "string"
                },
                "presas": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "quepared": {
                  "type": "integer",
                  "enum": [15, 25]
                },
                "isbloque": {
                  "type": "string",
                  "enum": ["bloque", "travesia"]
                }
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "schema": {
              "type": "object",
              "items": {
                "$ref": "#/definitions/Via"
              }
            },
            "examples": {
              "application/json": {
                "itinerario": {
                  "name": "Mi via",
                  "autor": "Juanito",
                  "dificultad": 7,
                  "comentario": "Una via guapisima",
                  "presas": ["A", "B", "C"],
                  "quepared": 15,
                  "isbloque": "bloque"
                },
                "Mensaje": "itinerario modificado con éxito"
              }
            }
          }
        }
      }
    },
    "/borrar/id": {
      "delete": {
        "summary": "Ejemplo de solicitud DELETE para eliminar un articulo",
        "consumes": ["multipart/form-data"],
        "parameters": [
          {
            "description": "El id del itinerario a eliminar se pasa por url, por ejemplo, si el id es 5783 la petición sería /editar/5783."
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "schema": {
              "type": "object",
              "items": {
                "$ref": "#/definitions/Via"
              }
            },
            "examples": {
              "application/json": {
                "itinerario": {
                  "name": "Mi via",
                  "autor": "Juanito",
                  "dificultad": 7,
                  "comentario": "Una via guapisima",
                  "presas": ["A", "B", "C"],
                  "quepared": 15,
                  "isbloque": "bloque"
                },
                "Mensaje": "itinerario eliminado con éxito"
              }
            }
          }
        }
      }
    },
    "/buscar?buscar=aquitextoabuscar&quepared=25": {
      "get": {
        "summary": "Ejemplo de solicitud GET para hacer una búsqueda",
        "consumes": ["multipart/form-data"],
        "responses": {
          "200": {
            "description": "Success",
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/Listado itinerarios"
              }
            },
            "examples": {
              "application/json": [
                {
                  "name": "Mi via",
                  "autor": "Juanito",
                  "dificultad": 7,
                  "comentario": "Una via guapisima",
                  "presas": ["A", "B", "C"],
                  "quepared": 15,
                  "isbloque": "bloque"
                }
              ]
            }
          }
        }
      }
    }
  },
  "definitions": {
