        "nombre_guardado": { "type": "string" },
        "tamano_bytes": { "type": "integer" },
        "url_publica": { "type": "string" }
      }
    },

    "Layout": {
      "type": "object",
      "properties": {
        "_id": { "type": "string" },
        "quepared": { "type": "string" },
        "name": { "type": "string" },
        "ledCount": { "type": "integer" },
        "baseWidth": { "type": "integer" },
        "baseHeight": { "type": "integer" },
        "defaultHoldSize": { "type": "integer" },
        "holds": {
          "type": "array",
          "items": {
