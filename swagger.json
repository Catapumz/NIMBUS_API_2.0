        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "autor": {
            "type": "string"
          },
          "dificultad": {
            "type": "integer"
          },
          "comentario": {
            "type": "string"
          },
          "presas": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "quepared": {
            "type": "integer",
            "enum": [15, 25]
          },
          "isbloque": {
            "type": "string",
